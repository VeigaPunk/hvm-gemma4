# Machine-local overrides for plazir27 (vhpnk). Source alongside tuned.env.
export PATH="$HOME/.cargo/bin:$PATH"          # bend 0.2.38
export HVM4_ROOT="$HOME/Projects/HVM4"        # overrides hardcoded /home/arara/Projects/HVM4
export HVM4_BIN="$HVM4_ROOT/src/hvm"
export BEND_BIN="$HOME/.cargo/bin/bend"
# restored GGUF is q4_0 -> the 'official-q4' lane, not the Q4_K_M default
export HVM_GEMMA_MODEL="gemma4-hvm:official-q4"
export MODEL_TAG="gemma4-hvm:official-q4"
export OLLAMA_MODELS="${XDG_CACHE_HOME:-$HOME/.cache}/ollama/models"
